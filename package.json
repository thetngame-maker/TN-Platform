{
  "name": "tn-platform",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:api && npm run test:contracts && npm run test:entity && npm run test:relationship && npm run test:graph",
    "test:api": "npm --prefix services/platform-core-api test",
    "test:contracts": "node --test packages/contracts/test/*.test.mjs && npm run test:contracts:php",
    "test:contracts:php": "php packages/contracts/test/entity-contracts.test.php",
    "test:entity": "php -d zend.assertions=1 -d assert.exception=1 packages/entity/tests/entity-foundation.test.php",
    "test:relationship": "php -d zend.assertions=1 -d assert.exception=1 packages/relationship/tests/relationship-engine.test.php",
    "test:graph": "php -d zend.assertions=1 -d assert.exception=1 packages/graph/tests/graph-engine.test.php",
    "check": "npm run check:node && npm run check:php",
    "check:node": "node --check services/platform-core-api/src/server.js && node --check scripts/build-releases.mjs",
    "check:php": "bash scripts/check-php.sh",
    "build": "node scripts/build-releases.mjs",
    "release": "npm run check && npm test && npm run build"
  },
  "engines": {"node": ">=20"}
}
