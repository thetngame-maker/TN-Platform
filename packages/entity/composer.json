{
  "name": "tn-platform/entity",
  "description": "Framework-agnostic canonical entity implementation for TN Platform.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "tn-platform/contracts": "1.0.0-alpha.1"
  },
  "autoload": {
    "psr-4": {
      "TN\\Entity\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../contracts",
      "options": {"symlink": false}
    }
  ],
  "config": {"sort-packages": true}
}
