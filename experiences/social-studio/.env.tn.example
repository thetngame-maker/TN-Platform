# TN Social Studio / BrightBean production example
# Copy values into the deployment platform's secret/environment manager.
# Never commit real credentials.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY_SALT=CHANGE_ME
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tn_social_studio

ALLOWED_HOSTS=studio.thetngame.com
APP_URL=https://studio.thetngame.com

# Production media should use persistent object storage.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=tn-social-studio

# Optional email / account services
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
UNSPLASH_ACCESS_KEY=

# Add social-platform developer credentials using the variable names
# documented by the pinned BrightBean upstream version.
